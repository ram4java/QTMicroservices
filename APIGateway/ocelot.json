{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Hello/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7100
        },
        {
          "Host": "localhost",
          "Port": 7120
        },
        {
          "Host": "localhost",
          "Port": 7130
        }
      ],
      "UpstreamPathTemplate": "/Hello/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "60s",
        "PeriodTimespan": 30,
        "Limit": 10,
        "ClientIdHeader": "X-Client-ID",
        "QuotaExceededMessage": "Limit to make no of calls is reached"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Greetings/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7200
        }
      ],
      "UpstreamPathTemplate": "/Greetings/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/minimal/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7200
        }
      ],
      "UpstreamPathTemplate": "/GreetingsMinimal/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // --- Static Routes for Aggregation with key ---
    {
      "DownstreamPathTemplate": "/api/Hello",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7100
        }
      ],
      "UpstreamPathTemplate": "/HelloBaseInternal",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "HelloService"
    },
    {
      "DownstreamPathTemplate": "/api/Greetings",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7200
        }
      ],
      "UpstreamPathTemplate": "/GreetingsBaseInternal",
      "UpstreamHttpMethod": [ "GET" ],
      "Key": "GreetingsService"
    }
  ],
  "Aggregates": [
    {
      "RouteKeys": [ "HelloService", "GreetingsService" ],
      "UpstreamPathTemplate": "/callBothServices"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7000"
  }  
}
